{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ApexTerm",
  "version": "1.0.3",
  "identifier": "com.mac.apexterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ApexTerm",
        "width": 1240,
        "height": 800,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 12, "y": 14 },
        "dragDropEnabled": true,
        "backgroundColor": "#141416"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyOTM3MzY5MEVBREM4MzYKUldRMnlLME9hWE9USW40Q2hpRGZTZitJZUtESXN1aEViWTRhTzdXQ2RxNFpKN1FZZXVESFNyc1cK",
      "endpoints": ["https://github.com/liubao-cn/ApexTerm/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
